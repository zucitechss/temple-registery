# ============================================================================
# E2E environment template — placeholders only, safe to commit.
#   cp e2e/.env.example e2e/.env   &&   fill in real values
# e2e/.env is git-ignored (**/.env). Never point these at a shared or
# production database: the suite writes data.
# ============================================================================

# Execution profile
E2E_TARGET=local
E2E_READ_ONLY=false

# Frontend + backend
E2E_BASE_URL=http://localhost:5173
E2E_API_ORIGIN=http://localhost:8080
# Optional override if backend is mounted differently
# E2E_API_V1_BASE=http://localhost:8080/api/v1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=<db-username>
DB_PASSWORD=<db-password>
DB_NAME=temple_registry

# Role credentials
E2E_SA_USERNAME=super_admin
E2E_SA_PASSWORD=<set-from-your-local-seed-or-CI-secret>

E2E_DC_USERNAME=dc_mysuru
E2E_DC_PASSWORD=<set-from-your-local-seed-or-CI-secret>

E2E_DC_STAFF_USERNAME=dc_staff_mysuru
E2E_DC_STAFF_PASSWORD=<set-from-your-local-seed-or-CI-secret>

E2E_TA_USERNAME=ta_chamundi
E2E_TA_PASSWORD=<set-from-your-local-seed-or-CI-secret>

E2E_AUDITOR_USERNAME=auditor_dev
E2E_AUDITOR_PASSWORD=<set-from-your-local-seed-or-CI-secret>

E2E_VIEWER_USERNAME=viewer_state
E2E_VIEWER_PASSWORD=<set-from-your-local-seed-or-CI-secret>

# Optional Playwright runtime knobs
# PLAYWRIGHT_WORKERS=2
# PLAYWRIGHT_RETRIES=0
# PLAYWRIGHT_ACTION_TIMEOUT=10000
# PLAYWRIGHT_NAV_TIMEOUT=30000
