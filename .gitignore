# ============================================================
# TEMPLE REGISTRY — ROOT .gitignore
# ============================================================

# ─── IDE & Editor ───────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.user
.classpath
.project
.settings/

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Node / npm ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Frontend build artefacts ───────────────────────────────
frontend/dist/
frontend/tsconfig.app.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo

# ─── Frontend secrets & env ─────────────────────────────────
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# ─── Frontend log / debug dumps ─────────────────────────────
frontend/dev_log.txt
frontend/frontend-test.log
frontend/frontend_dev.log
frontend/vitest_full.txt
frontend/vitest_out.txt
frontend/vitest_targeted.txt
frontend/vitest_targeted2.txt
frontend/coverage
# ─── Backend build artefacts ────────────────────────────────
backend/target/
backend/BOOT-INF/
*.class

# ─── Backend — private keys / secrets ───────────────────────
# JWT PEMs are never committed. Production supplies them via
# APP_JWT_PRIVATE_KEY / APP_JWT_PUBLIC_KEY (see backend/.env.example);
# local dev generates its own pair under keys/.
backend/src/main/resources/keys/
backend/src/main/resources/application-prod.yml
backend/dev-secrets.properties
backend/.env

