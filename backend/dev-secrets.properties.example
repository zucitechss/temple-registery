# ============================================================================
# DEV SECRETS TEMPLATE — safe to commit (no real values)
# ============================================================================
# 1. Copy this file:  cp dev-secrets.properties.example dev-secrets.properties
# 2. Fill in your real values in dev-secrets.properties
# 3. dev-secrets.properties is git-ignored and must never be committed
#
# Loaded by application-dev.yml via:
#   spring.config.import=optional:file:./dev-secrets.properties
# ============================================================================

# ─── Datasource ─────────────────────────────────────────────────────────────
# application.yml has NO defaults for these (C-6) — the dev profile falls back
# to a local MySQL only for DB_URL. Point this at your OWN database.
DB_URL=jdbc:mysql://localhost:3306/temple_registry?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# ─── SMTP (optional in dev; spring.mail.enabled controls dispatch) ──────────
SMTP_USERNAME=your-smtp-email@example.com
SMTP_PASSWORD=your-smtp-app-password

# ─── Application crypto — each MUST be exactly 32 bytes ─────────────────────
# Generate with: openssl rand -base64 24
# The historic placeholders are rejected outside dev/test by CryptoKeyValidator.
APP_ENCRYPTION_KEY=replace-with-32-byte-secret-key!!
APP_HMAC_KEY=replace-with-32-byte-hmac-key!!!!

# ─── JWT RS256 keypair (C-1) ────────────────────────────────────────────────
# Local dev may keep PEM files under src/main/resources/keys/ (git-ignored):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out src/main/resources/keys/jwt-private.pem
#   openssl rsa -pubout -in src/main/resources/keys/jwt-private.pem \
#       -out src/main/resources/keys/jwt-public.pem
# Or supply the PEM bodies inline, exactly as production does:
# APP_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APP_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ─── Initial SUPER_ADMIN bootstrap (see V116__bootstrap_super_admin.sql) ────
# A fresh dev database has no seeded users (same as production, C-5). Set
# these to get a working local login — PASSWORD_HASH must be a bcrypt hash
# (cost 12), not a plaintext password:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt(12)).decode())"
# Only takes effect on the deploy that first applies V116 to this database —
# see that migration's header comment before relying on it.
# APP_BOOTSTRAP_ADMIN_USERNAME=dev_admin
# APP_BOOTSTRAP_ADMIN_EMAIL=dev_admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD_HASH=
