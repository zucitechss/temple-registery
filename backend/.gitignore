# Git-ignore rules for backend
target/
*.class

# Never commit JWT/RSA private keys. Production supplies them through
# APP_JWT_PRIVATE_KEY / APP_JWT_PUBLIC_KEY env vars (see backend/.env.example).
src/main/resources/keys/

# NOTE: application-prod.yml IS tracked. It contains configuration only --
# every secret in it is an ${ENV_VAR} placeholder with no default.

# IDE
.idea/
*.iml
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

backend/exports
