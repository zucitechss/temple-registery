# ============================================================================
# Backend environment template — safe to commit (placeholders only).
#
#   cp backend/.env.example backend/.env    &&    fill in real values
#
# backend/.env is git-ignored (**/.env in the root .gitignore) and must never
# be committed. In staging/production these values come from the platform
# secret store, not from a file.
# ============================================================================

# ─── Datasource (no defaults in application.yml — all three are required) ───
# Full JDBC URL including host, port, database and connection parameters.
DB_URL=jdbc:mysql://<db-host>:<db-port>/<db-name>?useSSL=true&serverTimezone=UTC
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# ─── HTTP ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Application crypto (both MUST be exactly 32 bytes) ─────────────────────
# Generate with:  openssl rand -base64 24
# Startup fails if these are missing or still set to a known placeholder.
APP_ENCRYPTION_KEY=<32-byte-aes-key>
APP_HMAC_KEY=<32-byte-hmac-key>

# ─── JWT RS256 signing keypair ──────────────────────────────────────────────
# Supply the PEM contents directly so no key file has to be committed.
# Generate a fresh pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out jwt-private.pem && \
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
# Paste the full PEM including the BEGIN/END lines. Literal "\n" is accepted
# for platforms whose UI cannot hold multi-line values.
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
# Local dev alternative: leave the two vars above empty and point these at
# files under backend/src/main/resources/keys/ (git-ignored).
# APP_JWT_PRIVATE_KEY_PATH=classpath:keys/jwt-private.pem
# APP_JWT_PUBLIC_KEY_PATH=classpath:keys/jwt-public.pem

# ─── Base URL used in outbound email links ──────────────────────────────────
APP_BASE_URL=http://localhost:5173

# ─── SMTP (prod profile requires SMTP_HOST, EMAIL_USERNAME, EMAIL_PASSWORD) ─
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=<smtp-username>
EMAIL_PASSWORD=<smtp-app-password>
EMAIL_FROM=noreply@templeregistry.gov.in

# ─── Initial SUPER_ADMIN bootstrap (see C-5 / BootstrapAdminInitializer) ────
# Enable ONCE on a brand-new production database, then disable and redeploy.
# Ignored if any SUPER_ADMIN already exists.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
